{
  "name": "hypercms",
  "version": "0.1.0",
  "description": "Live edit-in-place CMS sidebar for HTML pages with a hyper-html-api rules tag",
  "keywords": [
    "HTML",
    "CMS",
    "hyperclay",
    "edit-in-place",
    "form"
  ],
  "homepage": "https://github.com/panphora/hypercms",
  "bugs": {
    "url": "https://github.com/panphora/hypercms/issues"
  },
  "license": "0BSD",
  "author": "David Miranda",
  "type": "module",
  "main": "src/hypercms.js",
  "module": "src/hypercms.js",
  "exports": {
    ".": "./src/hypercms.js",
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "LICENSE",
    "README.md",
    "src/**/*.js",
    "src/**/*.css",
    "dist/*.js"
  ],
  "scripts": {
    "build": "npx esbuild src/hypercms-bundle.js --bundle --minify --format=iife --global-name=hypercms --loader:.css=text --outfile=dist/hypercms.min.js",
    "prepublishOnly": "npm run build",
    "copy-to-hyperclayjs": "npm run build && node scripts/copy-to-hyperclayjs.js",
    "test:node": "node --test 'test-node/**/*.test.js'",
    "test": "npm run test:node",
    "demo": "http-server . -p 5694 -c-1 -o /demo/",
    "release": "./scripts/release.sh"
  },
  "dependencies": {
    "hyper-html-api": "file:../hyper-html-api",
    "hyper-morph": "file:../hyper-morph"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "http-server": "^14.1.1",
    "jsdom": "^25.0.0"
  }
}
