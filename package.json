{
  "name": "@panphora/hyper-cms",
  "version": "0.6.1",
  "description": "Live edit-in-place CMS sidebar for HTML pages with a hyper-html-api rules tag",
  "keywords": [
    "HTML",
    "CMS",
    "hyperclay",
    "edit-in-place",
    "form"
  ],
  "homepage": "https://github.com/panphora/hypercms",
  "bugs": {
    "url": "https://github.com/panphora/hypercms/issues"
  },
  "license": "0BSD",
  "author": "David Miranda",
  "type": "module",
  "main": "src/hypercms.js",
  "module": "src/hypercms.js",
  "exports": {
    ".": "./src/hypercms.js",
    "./styles.css": "./src/theme.generated.css",
    "./theme.css": "./src/theme.generated.css"
  },
  "files": [
    "LICENSE",
    "README.md",
    "src/**/*.js",
    "src/**/*.css",
    "dist/*.js"
  ],
  "scripts": {
    "build:theme": "node scripts/build-theme.js",
    "build": "npm run build:theme && npx esbuild src/hypercms-bundle.js --bundle --minify --format=iife --global-name=hypercms --loader:.css=text --outfile=dist/hypercms.min.js",
    "prepublishOnly": "npm run build",
    "copy-to-hyperclayjs": "npm run build && node scripts/copy-to-hyperclayjs.js",
    "test:node": "node --test 'test-node/**/*.test.js'",
    "test": "npm run test:node",
    "demo": "http-server . -p 5694 -c-1 -o /demo/",
    "release": "./scripts/release.sh",
    "test:browser": "web-test-runner",
    "test:all": "npm run test:node && npm run test:browser"
  },
  "dependencies": {
    "hyper-html-api": "^0.2.0",
    "hyper-morph": "^0.3.0"
  },
  "devDependencies": {
    "@open-wc/testing": "^4.0.0",
    "@web/dev-server-import-maps": "^0.2.1",
    "@web/test-runner": "^0.18.3",
    "@web/test-runner-chrome": "^0.16.0",
    "esbuild": "^0.25.0",
    "http-server": "^14.1.1",
    "jsdom": "^25.0.0"
  },
  "hyper": {
    "kind": "lib",
    "status": "active"
  }
}
